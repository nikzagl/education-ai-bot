  "grades": {
    "7": {
      "Математика": {
        "id": "math_7",
        "display_name": "Математика 7 класс",
        "description": "Алгебра и геометрия 7 класса",
        "topics": [
          {
            "id": "linear_equations",
            "name": "Линейные уравнения",
            "description": "Уравнения вида ax + b = 0, методы решения",
            "difficulty": 2,
            "prerequisites": ["basic_arithmetic"],
            "learning_objectives": [
              "Понимать, что такое линейное уравнение",
              "Уметь переносить слагаемые из одной части в другую",
              "Решать уравнения с одной переменной"
            ],
            "common_mistakes": [
              "Неправильный перенос знаков",
              "Ошибки в умножении/делении отрицательных чисел",
              "Потеря корней при сокращении"
            ],
            "examples": [
              "2x + 5 = 13",
              "3(x - 2) = 15",
              "4x - 7 = 2x + 5"
            ],
            "resources": [
              "§1-3 учебника алгебры",
              "Видео: решение линейных уравнений"
            ]
          },
          {
            "id": "quadratic_equations",
            "name": "Квадратные уравнения",
            "description": "Уравнения вида ax² + bx + c = 0",
            "difficulty": 3,
            "prerequisites": ["linear_equations", "square_roots", "multiplication_polynomials"],
            "learning_objectives": [
              "Понимать структуру квадратного уравнения",
              "Знать формулу дискриминанта",
              "Уметь решать уравнения через дискриминант",
              "Знать теорему Виета"
            ],
            "common_mistakes": [
              "Неправильное вычисление дискриминанта",
              "Потеря знаков при подстановке в формулу",
              "Забывают про два корня"
            ],
            "examples": [
              "x² - 5x + 6 = 0",
              "2x² + 3x - 5 = 0",
              "x² - 4x + 4 = 0"
            ],
            "resources": [
              "§5-7 учебника алгебры",
              "Таблица формул сокращенного умножения"
            ]
          },
          {
            "id": "systems_equations",
            "name": "Системы уравнений",
            "description": "Решение систем линейных уравнений",
            "difficulty": 3,
            "prerequisites": ["linear_equations", "basic_algebra"],
            "learning_objectives": [
              "Понимать, что такое система уравнений",
              "Уметь решать системы методом подстановки",
              "Уметь решать системы методом сложения",
              "Проверять решение подстановкой"
            ],
            "common_mistakes": [
              "Неправильное выражение переменной",
              "Арифметические ошибки",
              "Потеря одного из уравнений"
            ],
            "examples": [
              "{ x + y = 10, 2x - y = 5 }",
              "{ 3x + 2y = 12, x - y = 1 }"
            ]
          },
          {
            "id": "foiling",
            "name": "Формулы сокращенного умножения",
            "description": "(a+b)², (a-b)², a²-b² и другие формулы",
            "difficulty": 2,
            "prerequisites": ["multiplication_polynomials"],
            "learning_objectives": [
              "Знать основные формулы",
              "Уметь применять формулы в обе стороны",
              "Раскладывать выражения на множители"
            ],
            "formulas": [
              "(a + b)² = a² + 2ab + b²",
              "(a - b)² = a² - 2ab + b²",
              "a² - b² = (a - b)(a + b)",
              "(a + b)³ = a³ + 3a²b + 3ab² + b³"
            ]
          },
          {
            "id": "geometry_triangles",
            "name": "Треугольники и их свойства",
            "description": "Виды треугольников, сумма углов, неравенство треугольника",
            "difficulty": 2,
            "prerequisites": ["basic_geometry"],
            "learning_objectives": [
              "Классифицировать треугольники",
              "Знать теорему о сумме углов",
              "Понимать неравенство треугольника"
            ]
          },
          {
            "id": "pythagorean_theorem",
            "name": "Теорема Пифагора",
            "description": "Квадрат гипотенузы равен сумме квадратов катетов",
            "difficulty": 3,
            "prerequisites": ["geometry_triangles", "square_roots"],
            "learning_objectives": [
              "Знать формулировку теоремы",
              "Находить неизвестную сторону",
              "Применять в задачах"
            ],
            "examples": [
              "Катеты 3 и 4, найти гипотенузу",
              "Гипотенуза 10, катет 6, найти второй катет"
            ]
          }
        ]
      },
